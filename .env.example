# Public URL of the app. With the caddy profile, this is also the site Caddy gets a certificate for.
ORIGIN=https://music.example.com

# Password hash. Generate it with (prompts for the password):
#   docker compose run --rm -it music-map node --experimental-strip-types scripts/hash-password.ts
APP_PASSWORD_HASH=

# 32+ random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# Contact info for MusicBrainz/Wikidata (required by them). Without it, items only get the
# provider's genre and a decade tag, and there are no suggestions.
MB_USER_AGENT=MusicMap/1.0 (you@example.com)

# Optional
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# Advanced
# TRUST_PROXY=true     # use X-Forwarded-For for login rate limiting (keep true behind a proxy)
