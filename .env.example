# Public URL. Used for CSRF/origin checks, and https here turns on Secure cookies + HSTS.
ORIGIN=https://music.example.com
# From: npx tsx scripts/hash-password.ts
APP_PASSWORD_HASH=
# Random 32+ chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=
DATA_DIR=/data
# Contact info is required by MusicBrainz
MB_USER_AGENT=MusicMap/1.0 (you@example.com)
# Optional
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
# true when running behind a reverse proxy (uses X-Forwarded-For for login rate limiting)
TRUST_PROXY=true
PORT=3000
